# ─── LINE Messaging API ──────────────────────────────────────────────
# 從 LINE Developers Console → 你的 Provider → Channel (Messaging API) 拿
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 你自己的 LINE User ID (見 SETUP.md 的「取得自己的 User ID」)
LINE_USER_ID=

# ─── Notion ──────────────────────────────────────────────────────────
# Notion Integration 的 Internal Integration Token (https://notion.so/my-integrations)
NOTION_API_KEY=
# Data Source ID — 新版 Notion API 操作的是 data source 不是 database。
# 對單 data source 的 database 通常 1:1 但 ID 不同。
NOTION_DATA_SOURCE_ID=
# Database ID (可選) — 如果只設這個，程式會自動解析出 data_source_id
NOTION_DATABASE_ID=

# ─── Vercel Cron 驗證 ─────────────────────────────────────────────────
# 任意亂數字串，Vercel 會自動以 Bearer 帶過來。建議用 `openssl rand -hex 32`
CRON_SECRET=

# ─── 進階 ────────────────────────────────────────────────────────────
# 平行抓股價的 worker 數，預設 15，遇到 rate-limit 可調低
# STOCK_FETCH_WORKERS=15
